{
  "name": "device-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Capture and verify annotated evidence for native mobile apps.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:schema": "npm run build && node scripts/generate-schema.mjs",
    "check:schema": "npm run build && node scripts/generate-schema.mjs --check",
    "test": "npm run build && node --test test/unit/*.test.mjs",
    "check": "npm run typecheck && npm run test && node scripts/generate-schema.mjs --check"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "agent-device": "0.21.27"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.18.0",
    "typescript": "7.0.2"
  }
}
