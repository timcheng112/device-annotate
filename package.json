{
  "name": "device-annotate",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first screenshot annotation and visual assertions, powered by agent-device.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "device-annotate": "bin/device-annotate.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:schema": "npm run build && node scripts/generate-schema.mjs",
    "check:schema": "npm run build && node scripts/generate-schema.mjs --check",
    "test": "npm run build && node --experimental-strip-types --test test/unit/*.test.mjs test/vendor/*.test.ts test/golden/*.test.mjs",
    "check": "npm run typecheck && npm run test && node scripts/generate-schema.mjs --check && npm run check:vendor",
    "check:vendor": "node scripts/check-vendor.mjs",
    "compare:vendor": "node scripts/vendor-agent-device.mjs",
    "test:golden": "npm run build && node --test test/golden/*.test.mjs",
    "benchmark:render": "npm run build && node scripts/benchmark-render.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "opentype.js": "1.3.4",
    "pngjs": "7.0.0",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "agent-device": "0.21.27"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.18.0",
    "typescript": "7.0.2"
  }
}
