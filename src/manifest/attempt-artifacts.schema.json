{
  "$comment": "Generated by npm run generate:schema from src/manifest/artifacts.ts. Do not edit manually.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "step": {
      "$ref": "#/$defs/__schema0"
    },
    "attemptId": {
      "$ref": "#/$defs/__schema1"
    },
    "image": {
      "$ref": "#/$defs/__schema2"
    },
    "raw": {
      "$ref": "#/$defs/__schema3"
    },
    "snapshot": {
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": [
    "step",
    "attemptId"
  ],
  "additionalProperties": false,
  "description": "Managed artifact references for one attempt. Omit unavailable files. Complete validation uses attemptArtifactsSchema to bind paths to the exact step and attempt ID.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"
        },
        {
          "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)"
        }
      ]
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^attempts\\/[a-z][a-z0-9_-]{0,63}\\/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\/image\\.png(?![\\s\\S])"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^attempts\\/[a-z][a-z0-9_-]{0,63}\\/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\/raw\\.png(?![\\s\\S])"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^attempts\\/[a-z][a-z0-9_-]{0,63}\\/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\/snapshot\\.json(?![\\s\\S])"
    }
  }
}
