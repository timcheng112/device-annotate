        "specPath"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "one-off"
        },
        "step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*(?![\\s\\S])"
            },
            {
              "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)"
